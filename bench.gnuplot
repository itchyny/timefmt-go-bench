# Draws bench.svg from the benchmark results in the tab separated files
# generated by bench.sh. The first two columns of a file are the labels of a
# group and the rest are the benchmark results of each library. The graphs are
# drawn one above the other in a single image, so that they share the canvas
# width and the font size wherever the image is scaled to fit.

array tsvs[2] = ["bench-format.tsv", "bench-parse.tsv"]
array titles[2] = [ \
  "Time formatting (strftime) libraries performance comparison", \
  "Time parsing (strptime) libraries performance comparison"]

# Shown under the legend of the graph that draws imperfectgo, whose bar is
# not measured the same way as the rest.
note = "^{/*0.7 *} imperfectgo/go-strftime reaches into the\n" \
     . "  internals of the time package with\n" \
     . "  go:linkname, and no longer builds with Go\n" \
     . "  1.23 or later, where those internals were\n" \
     . "  rewritten. It is benchmarked with Go 1.22\n" \
     . "  instead, and scaled by the ratio of the\n" \
     . "  standard library benchmarks of the two\n" \
     . "  toolchains, so its bar is an estimate."

# Vertical distance between two entries of the legend, in pixels, which is
# the font size times the spacing set below.
keyline = 38.0

set datafile separator "\t" columnheaders

# Measure both files first, to size the canvas before drawing anything. A
# graph is as tall as its bars, plus a fixed amount for the title and the
# axis, so that the bars are equally thick in both graphs.
array groups[|tsvs|]
array series[|tsvs|]
array heights[|tsvs|]
canvas = 0
do for [n = 1:|tsvs|] {
  stats tsvs[n] using 3 nooutput
  groups[n] = STATS_records
  series[n] = (STATS_columns - 2) / 2
  heights[n] = 185 + groups[n] * series[n] * 18
  canvas = canvas + heights[n]
}

eval sprintf('set terminal svg size 1600,%d fontscale 1.3 ' \
            .'background rgb "white" font "monospace,11"', canvas)
set output "bench.svg"

# The standard library comes first and is drawn in grey, so that it stands
# out as the baseline in every graph, however many libraries are drawn.
colors = "#4285f4 #db4437 #f4b400 #0f9d58 #ff6d01 #46bdc6 " \
        ."#7baaf7 #e67c73 #ab47bc #9e9d24 #795548 #f06292 #5c6bc0 #26a69a"
standardcolor = "#5f6368"

# Set to 1 to draw the standard deviation of the runs of a benchmark as an
# error bar at the end of its bar. The columns are always in the data files,
# so this only decides whether they are drawn.
errorbars = 0

# Padding above and below the outermost bars of a group.
padding = 0.7

set xlabel "Benchmark ns/op" offset 0,-0.4
set xrange [0:550]
set grid xtics mxtics lt 1 lc rgb "#cccccc", lt 1 lc rgb "#e8e8e8"
set mxtics 2
set border 3 lc rgb "#808080"
set tics nomirror textcolor rgb "#202020"
set ytics scale 0
set style fill solid noborder
set bars 0.4  # the caps of the error bars

# The bars are drawn as boxxyerror, since boxes are vertical only. Each bar
# spans from zero to its value, and is shifted within its group by the index.
# The first plot of a graph draws nothing but the format label at the center
# of a group.
set multiplot
top = 1.0
do for [n = 1:|tsvs|] {
  height = 0.82 / series[n]
  plottop = top - 90.0 / canvas
  plotbottom = top - (heights[n] - 95.0) / canvas
  plotmiddle = (plottop + plotbottom) / 2
  set tmargin at screen plottop
  set bmargin at screen plotbottom
  set lmargin at screen 0.222
  set rmargin at screen 0.690

  # The legend is centred against the graph, and the footnote of the libraries
  # marked with an asterisk follows below it.
  set key at screen 0.710, screen plotmiddle left center vertical Left reverse \
      samplen 1.6 spacing 1.7 textcolor rgb "#202020" width 1
  unset label 1
  if (strstrt(system(sprintf("head -1 %s", tsvs[n])), "imperfectgo") > 0) {
    set label 1 note front font ",9" textcolor rgb "#606060" \
        at screen 0.710, screen plotmiddle - (series[n] * keyline / 2 + 34) / canvas
  }
  set title titles[n]." (lower is better)" font ",15" offset 0,0.4
  set yrange [groups[n] - 1 + padding : -padding]
  plot tsvs[n] using (0):($0):ytic(stringcolumn(1)."\n(".stringcolumn(2).")") \
         with points pointsize 0 notitle, \
       for [s = 1 : series[n]] tsvs[n] \
         using (column(2 * s + 1) / 2) : \
               ($0 + (s - (series[n] + 1) / 2.0) * height) : \
               (column(2 * s + 1) / 2) : \
               (height / 2) \
         with boxxyerror title columnheader(2 * s + 1) \
         lc rgb (s == 1 ? standardcolor : word(colors, s - 1)), \
       for [s = 1 : series[n]] tsvs[n] \
         using (column(2 * s + 1)) : \
               ($0 + (s - (series[n] + 1) / 2.0) * height) : \
               (errorbars ? column(2 * s + 2) : NaN) \
         with xerrorbars lc rgb "#202020" pointsize 0 notitle
  top = top - heights[n] / (canvas + 0.0)
}
unset multiplot
